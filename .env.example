# -------------------------------------------------------------
# Backend Environment Variables (Render Web Service)
# -------------------------------------------------------------

# Required for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for persistent storage in production (MongoDB Atlas M0 free tier)
# Defaults to mongodb://127.0.0.1:27017/jobpilot if omitted.
MONGODB_URI="mongodb://127.0.0.1:27017/jobpilot"

# Comma-separated frontend origin(s) allowed by CORS when hosted separately
# Example: https://jobpilot-frontend.onrender.com
FRONTEND_URL=""

# Optional server port (Render injects PORT automatically)
PORT=3000

# Optional keep-alive settings for Render free tier (15-min idle spin-down)
# Render injects RENDER_EXTERNAL_URL automatically; set KEEP_ALIVE_URL only if overriding.
KEEP_ALIVE_ENABLED="true"
KEEP_ALIVE_INTERVAL_MINUTES=10
KEEP_ALIVE_URL=""

# -------------------------------------------------------------
# Frontend Environment Variables (Render Static Site)
# -------------------------------------------------------------

# Full base URL of your deployed backend service (no trailing slash)
# Leave empty during local `npm run dev` (same-origin Vite middleware).
# Example: https://jobpilot-backend.onrender.com
VITE_API_URL=""
